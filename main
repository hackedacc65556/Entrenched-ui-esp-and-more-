-- [[ NAVIGATION LOGIC ]]
local function switch_tab(tab_name)
    UI_STATE.CurrentTab = tab_name
    for name, page in pairs(TabPages) do
        page.Visible = (name == tab_name)
    end
end

local nav_layout = Instance.new("UIListLayout")
nav_layout.Parent = NavContainer

for tab_name, _ in pairs(TabPages) do
    local btn = Instance.new("TextButton")
    btn.Text = tab_name
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.TextColor3 = Color3.fromRGB(150, 150, 150)
    btn.Font = Enum.Font.Gotham
    btn.BorderSizePixel = 0
    btn.Parent = NavContainer

    btn.MouseButton1Click:Connect(function()
        switch_tab(tab_name)
    end)
end

-- [[ ENGINE: ESP & TEAM CHECK LOOP ]]
task.spawn(function()
    RunService.Heartbeat:Connect(function()
        if not UI_STATE.ESP_Enabled then
            for _, highlight in pairs(ESP_CACHE) do highlight:Destroy() end
            ESP_CACHE = {}
            return
        end

        for _, player in pairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end

            safe_call(function()
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end

                local highlight = ESP_CACHE[player]
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "HubESP_" .. player.Name
                    highlight.FillTransparency = ESP_SETTINGS.DefaultTransparency
                    highlight.OutlineTransparency = 0
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = char
                    ESP_CACHE[player] = highlight
                end

                -- Team Check Logic
                if UI_STATE.TeamCheck_Enabled then
                    if player.Team == LocalPlayer.Team then
                        highlight.FillColor = ESP_SETTINGS.AllyColor
                        highlight.OutlineColor = ESP_SETTINGS.AllyColor
                    else
                        highlight.FillColor = ESP_SETTINGS.EnemyColor
                        highlight.OutlineColor = ESP_SETTINGS.EnemyColor
                    end
                end

                -- Wall Check Logic
                if UI_STATE.WallCheck_Enabled then
                    local has_los = perform_wall_check(char.HumanoidRootPart)
                    highlight.FillTransparency = has_los and ESP_SETTINGS.DefaultTransparency or ESP_SETTINGS.OccludedTransparency
                    highlight.OutlineColor = has_los and highlight.FillColor or ESP_SETTINGS.WallColor
                end
            end)
        end

        -- Cleanup disconnected players
        for player, highlight in pairs(ESP_CACHE) do
            if not player.Parent then
                highlight:Destroy()
                ESP_CACHE[player] = nil
            end
        end
    end)
end)

-- [[ ENGINE: TELEPORTATION LOGIC ]]
TP_Button.MouseButton1Click:Connect(function()
    local query = TP_Input.Text:lower()
    if query == "" then return end

    local target_player = nil
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower():find(query) or p.DisplayName:lower():find(query) then
            target_player = p
            break
        end
    end

    if target_player then
        safe_call(function()
            local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local target_root = target_player.Character:FindFirstChild("HumanoidRootPart")
            if root and target_root then
                root.CFrame = target_root.CFrame * CFrame.new(0, 2, 0) -- Vertical offset to prevent clipping
            end
        end)
    else
        warn("[HUB]: Target player not found in current lobby.")
    end
end)

-- [[ BUTTON EVENTS ]]
ESP_Toggle.MouseButton1Click:Connect(function()
    UI_STATE.ESP_Enabled = not UI_STATE.ESP_Enabled
    ESP_Toggle.Text = "Toggle ESP: " .. (UI_STATE.ESP_Enabled and "ON" or "OFF")
    ESP_Toggle.BackgroundColor3 = UI_STATE.ESP_Enabled and Color3.fromRGB(60, 120, 60) or Color3.fromRGB(45, 45, 45)
end)

WallCheck_Toggle.MouseButton1Click:Connect(function()
    UI_STATE.WallCheck_Enabled = not UI_STATE.WallCheck_Enabled
    WallCheck_Toggle.Text = "Raycast Wall Check: " .. (UI_STATE.WallCheck_Enabled and "ON" or "OFF")
    WallCheck_Toggle.BackgroundColor3 = UI_STATE.WallCheck_Enabled and Color3.fromRGB(60, 120, 60) or Color3.fromRGB(45, 45, 45)
end)

-- [[ TOGGLE BINDING ]]
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        UI_STATE.Visible = not UI_STATE.Visible
        MainFrame.Visible = UI_STATE.Visible
    end
end)
