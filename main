local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- [[ CONFIGURATION & STATE ]]
local UI_STATE = {
    Visible = true,
    CurrentTab = "ESP",
    ESP_Enabled = false,
    WallCheck_Enabled = false,
    TeamCheck_Enabled = true,
    Loadout = "None"
}

local ESP_SETTINGS = {
    AllyColor = Color3.fromRGB(50, 255, 50),
    EnemyColor = Color3.fromRGB(255, 50, 50),
    WallColor = Color3.fromRGB(150, 150, 150),
    DefaultTransparency = 0.5,
    OccludedTransparency = 0.8
}

local ESP_CACHE = {}

-- [[ UTILITY FUNCTIONS ]]
local function safe_call(func, ...)
    local success, result = pcall(func, ...)
    if not success then
        warn("[HUB ERROR]: " .. tostring(result))
    end
    return success, result
end

