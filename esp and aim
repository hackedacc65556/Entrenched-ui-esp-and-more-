-- [[ ENGINE: COMBAT/LOCK-ON LOOP ]]
RunService.RenderStepped:Connect(function()
    if not UI_STATE.Aimbot_Enabled then return end

    local target = get_closest_player()
    if target and target.Character and target.Character:FindFirstChild("Head") then
        -- Smoothly lock camera to head
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character.Head.Position)
    end
end)

-- [[ ENGINE: ESP LOOP ]]
task.spawn(function()
    RunService.Heartbeat:Connect(function()
        if not UI_STATE.ESP_Enabled then
            for _, highlight in pairs(ESP_CACHE) do highlight:Destroy() end
            ESP_CACHE = {}
            return
        end

        for _, player in pairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end

            safe_call(function()
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end

                local highlight = ESP_CACHE[player]
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "HubESP_" .. player.Name
                    highlight.FillTransparency = ESP_SETTINGS.DefaultTransparency
                    highlight.OutlineTransparency = 0
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = char
                    ESP_CACHE[player] = highlight
                end

                if UI_STATE.TeamCheck_Enabled then
                    if player.Team == LocalPlayer.Team then
                        highlight.FillColor = ESP_SETTINGS.AllyColor
                        highlight.OutlineColor = ESP_SETTINGS.AllyColor
                    else
                        highlight.FillColor = ESP_SETTINGS.EnemyColor
                        highlight.OutlineColor = ESP_SETTINGS.EnemyColor
                    end
                end
            end)
        end
    end)
end)

